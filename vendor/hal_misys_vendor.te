attribute hal_misys_vendor;
attribute hal_misys_vendor_client;
attribute hal_misys_vendor_server;

type hal_misys_vendor_service, hal_service_type, protected_service, service_manager_type;

hal_server_domain(hal_misys_default, hal_misys_vendor)
hal_client_domain(platform_app, hal_misys_vendor)

binder_call(hal_misys_vendor_client, hal_misys_vendor_server)
add_service(hal_misys_vendor_server, hal_misys_vendor_service)
allow hal_misys_vendor_client hal_misys_vendor_service:service_manager find;
