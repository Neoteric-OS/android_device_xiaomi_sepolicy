typeattribute platform_app system_executes_vendor_violators;
typeattribute platform_app_36 system_executes_vendor_violators;

# Audio
allow platform_app_all vendor_audio_data_file:dir write;
allow platform_app_all vendor_audio_data_file:dir { add_name search };
allow platform_app_all vendor_audio_data_file:file { append create getattr open read setattr write };
allow platform_app_all sound_device:chr_file { open read write };
get_prop(platform_app_all, vendor_audio_prop)

# Camera
allow platform_app_all adsprpcd_file:dir { getattr search };
allow platform_app_all adsprpcd_file:file { getattr open read };
allow platform_app_all app_data_file:file execute;
allow platform_app_all hal_aidlbgservice_service:service_manager find;
allow platform_app_all hal_aidlbgservice:binder { call transfer };
allow platform_app_all hal_aidlbgservice:binder transfer;
allow platform_app_all hal_aidlbgservice:fd *;
allow platform_app_all hal_camera_default:binder { call transfer };
allow platform_app_all hal_camera_default:binder transfer;
allow platform_app_all hal_camera_default:fd *;
allow platform_app_all hal_quickcamera_hwservice:hwservice_manager find;
allow platform_app_all hal_quickcamera_service:service_manager find;
allow platform_app_all hal_quickcamera:binder { call transfer };
allow platform_app_all hal_quickcamera:binder transfer;
allow platform_app_all hal_quickcamera:fd *;
allow platform_app_all hal_quickcamera_default:binder { call transfer };
allow platform_app_all hal_quickcamera_default:binder transfer;
allow platform_app_all hal_quickcamera_default:fd *;
allow platform_app_all vendor_file:dir { watch };
allow platform_app_all vendor_file:file { read open getattr map execute};
allow platform_app_all vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
allow platform_app_all vendor_hal_camerapostproc_xiaomi:binder { call transfer };
allow platform_app_all vendor_hal_camerapostproc_xiaomi:binder transfer;
allow platform_app_all vendor_hal_camerapostproc_xiaomi:fd *;
binder_call(platform_app_all, hal_camera_default)
get_prop(platform_app_all, qemu_hw_prop)
get_prop(platform_app_all, vendor_camera_sensor_prop)
get_prop(platform_app_all, vendor_camera_p3enable_prop)
get_prop(platform_app_all, vendor_camera_xdrversion_prop)
get_prop(platform_app_all, vendor_camera_prop)
get_prop(platform_app_all, vendor_display_prop)
get_prop(platform_app_all, vendor_panel_info_prop)
hal_client_domain(platform_app, hal_aidlbgservice)
hal_client_domain(platform_app_36, hal_aidlbgservice)
hal_client_domain(platform_app, hal_misys)
hal_client_domain(platform_app_36, hal_misys)
hal_client_domain(platform_app, vendor_hal_camerapostproc_xiaomi)
hal_client_domain(platform_app_36, vendor_hal_camerapostproc_xiaomi)
hal_client_domain(platform_app, hal_quickcamera)
hal_client_domain(platform_app_36, hal_quickcamera)

# Displayfeature
allow platform_app_all vendor_hal_displayfeature_xiaomi_hwservice:hwservice_manager find;
allow platform_app_all vendor_hal_displayfeature_xiaomi_default:binder call;
get_prop(platform_app_all, vendor_displayfeature_prop)

# Dolby
hal_client_domain(platform_app, dvs_aidl)
hal_client_domain(platform_app_36, dvs_aidl)
hal_client_domain(platform_app, hal_aidl_dms)
hal_client_domain(platform_app_36, hal_aidl_dms)
hal_client_domain(platform_app, hal_dms)
hal_client_domain(platform_app_36, hal_dms)

# Misys
allow platform_app_all hal_misys_hwservice:hwservice_manager find;
allow platform_app_all hal_misys_default:binder call;

# Mlipay
hal_client_domain(platform_app, hal_mfidoca)
hal_client_domain(platform_app_36, hal_mfidoca)
hal_client_domain(platform_app, hal_mlipay)
hal_client_domain(platform_app_36, hal_mlipay)
hal_client_domain(platform_app, hal_mtdservice)
hal_client_domain(platform_app_36, hal_mtdservice)
hal_client_domain(platform_app, hal_tidaservice)
hal_client_domain(platform_app_36, hal_tidaservice)
allow platform_app_all hal_mfidoca_hwservice:hwservice_manager find;
allow platform_app_all hal_mfidoca_default:binder call;
allow platform_app_all hal_mlipay_hwservice:hwservice_manager find;
allow platform_app_all hal_mlipay_default:binder call;
allow platform_app_all hal_mtdservice_hwservice:hwservice_manager find;
allow platform_app_all hal_mtdservice_default:binder { call transfer };
allow platform_app_all hal_mtdservice_default:fd *;
allow platform_app_all hal_tidaservice_hwservice:hwservice_manager find;
allow platform_app_all hal_tidaservice_default:binder { call transfer };
allow platform_app_all hal_tidaservice_default:fd *;
get_prop(platform_app_all, vendor_payment_security_prop)

# Soter
hal_client_domain(platform_app, vendor_hal_soter);
hal_client_domain(platform_app_36, vendor_hal_soter);

# Touchfeature
allow platform_app_all hal_touchfeature_xiaomi_service:service_manager find;
allow platform_app_all hal_touchfeature_xiaomi_hwservice:hwservice_manager find;
